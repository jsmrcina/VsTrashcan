{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (Debug)",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "-c",
                "Debug"
            ]
        },
        {
            "label": "Build (Release)",
            "group": "build",
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": "$msCompile",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "-c",
                "Release"
            ]
        },
        {
            "label": "Test",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "type": "process",
            "command": "dotnet",
            "args": [
                "test",
                "tests/VsTrashcan.Tests"
            ]
        },
        {
            "label": "Smoke test (dedicated server)",
            "group": "test",
            "type": "process",
            "command": "bash",
