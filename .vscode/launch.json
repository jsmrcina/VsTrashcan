{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Client",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "Build (Debug)",
            "program": "dotnet",
            "args": [
                "${env:VINTAGE_STORY}/Vintagestory.dll",
                "--playStyle",
                "preset-surviveandbuild",
                "--openWorld",
                "modding test world",
                "--addModPath",
                "${workspaceFolder}/bin/Debug",
                "--addOrigin",
                "${workspaceFolder}/resources/assets",
            ],
            "cwd": "${env:VINTAGE_STORY}",
            "console": "internalConsole",
            "internalConsoleOptions": "openOnSessionStart",
        }
    ]
}
